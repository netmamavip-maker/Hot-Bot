# Copy this file's variable NAMES into Render's "Environment" tab.
# Never commit real values to GitHub.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq — chat + voice transcription (STT). Free tier, no billing needed.
GROQ_API_KEY=your_groq_api_key_here

# Gemini — vision (photo Q&A) + PDF summarization.
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (free tier) — image generate + edit.
# Get these two from dash.cloudflare.com:
#   Account ID -> right sidebar of any Workers & Pages page
#   API Token  -> My Profile -> API Tokens -> Create Token -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# No key needed for these (community free backends, used as-is):
#   - Ashlynn backup image generator   (/img2)
#   - still-queen backup image generator (/img3)
#   - Video Studio worker              (/video)
#   - TeCoxBeta web search             (/search)
# Microsoft Edge TTS (voice replies) also needs no key.

# --- Optional overrides (sensible defaults already set in the code) -------
# CHAT_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# TTS_VOICE=bn-BD-NabanitaNeural          # try bn-BD-PradeepNeural for a male voice
# GEMINI_VISION_MODEL=gemini-3.6-flash
# CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
# CLOUDFLARE_EDIT_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
# BACKUP_IMAGE_ENABLED=true
# STILLQUEEN_ENABLED=true
# VIDEO_ENABLED=true
# SEARCH_ENABLED=true
